diff --git a/src/tracing_ext.c b/src/tracing_ext.c
new file mode 100644
index 000000000..1ea9824ba
--- /dev/null
+++ b/src/tracing_ext.c
@@ -0,0 +1,124 @@
+/*
+ * tracing_ext.c -- shared state and per-syscall capture helpers for the
+ * strace-appimage tracing extensions (see tracing_ext.h).
+ *
+ * Copyright (c) 2026 The strace-appimage authors.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "defs.h"
+#include "tracing_ext.h"
+
+#include <stdio.h>
+
+/*
+ * Print a JSON string literal (with the surrounding quotes) into fp,
+ * escaping what must be escaped.  strace output can contain arbitrary
+ * tracee bytes, so escape strictly per RFC 8259 and switch to \uXXXX
+ * for anything not safely printable.  Shared by the --json event
+ * emitter and the --report-files dump.
+ */
+void
+ext_json_print_string(FILE *fp, const char *s)
+{
+	fputc('"', fp);
+	for (const unsigned char *p = (const unsigned char *) s; *p; ++p) {
+		switch (*p) {
+		case '"':
+			fputs("\\\"", fp);
+			break;
+		case '\\':
+			fputs("\\\\", fp);
+			break;
+		case '\b':
+			fputs("\\b", fp);
+			break;
+		case '\f':
+			fputs("\\f", fp);
+			break;
+		case '\n':
+			fputs("\\n", fp);
+			break;
+		case '\r':
+			fputs("\\r", fp);
+			break;
+		case '\t':
+			fputs("\\t", fp);
+			break;
+		default:
+			if (*p < 0x20 || *p == 0x7f)
+				fprintf(fp, "\\u%04x", *p);
+			else
+				fputc(*p, fp);
+		}
+	}
+	fputc('"', fp);
+}
+
+void
+ext_reset_paths(struct tcb *tcp)
+{
+	for (unsigned int i = 0; i < tcp->ext_npaths && i < EXT_MAX_PATHS_PER_SYSCALL; ++i) {
+		free(tcp->ext_paths[i]);
+		tcp->ext_paths[i] = NULL;
+	}
+	tcp->ext_npaths = 0;
+}
+
+void
+ext_note_path(struct tcb *tcp, const char *path)
+{
+	if (tcp->ext_npaths >= EXT_MAX_PATHS_PER_SYSCALL)
+		return;
+	tcp->ext_paths[tcp->ext_npaths++] = xstrdup(path);
+}
+
+void
+ext_reset_notes(struct tcb *tcp)
+{
+	for (unsigned int i = 0; i < tcp->ext_nnotes && i < EXT_MAX_NOTES_PER_SYSCALL; ++i) {
+		free(tcp->ext_notes[i]);
+		tcp->ext_notes[i] = NULL;
+	}
+	tcp->ext_nnotes = 0;
+}
+
+void
+ext_add_note(struct tcb *tcp, const char *note)
+{
+	if (tcp->ext_nnotes >= EXT_MAX_NOTES_PER_SYSCALL)
+		return;
+	tcp->ext_notes[tcp->ext_nnotes++] = xstrdup(note);
+}
+
+const char *
+ext_notes_joined(struct tcb *tcp, char sep)
+{
+	static char buf[256];
+	size_t off = 0;
+
+	buf[0] = '\0';
+	for (unsigned int i = 0; i < tcp->ext_nnotes; ++i) {
+		if (i) {
+			if (off + 1 >= sizeof(buf))
+				break;
+			buf[off++] = sep;
+			buf[off] = '\0';
+		}
+		size_t l = strlen(tcp->ext_notes[i]);
+		if (off + l >= sizeof(buf))
+			l = sizeof(buf) - 1 - off;
+		memcpy(buf + off, tcp->ext_notes[i], l);
+		off += l;
+		buf[off] = '\0';
+	}
+	return buf;
+}
+
+/* Free everything a tcb holds for the extensions; called from droptcb(). */
+void
+ext_free_tcb(struct tcb *tcp)
+{
+	ext_reset_paths(tcp);
+	ext_reset_notes(tcp);
+}
diff --git a/src/tracing_ext.h b/src/tracing_ext.h
new file mode 100644
index 000000000..694408711
--- /dev/null
+++ b/src/tracing_ext.h
@@ -0,0 +1,69 @@
+/*
+ * tracing_ext.h -- strace-appimage tracing extensions.
+ *
+ * Shared state and helpers for the packager-oriented extensions:
+ *   --json               machine-readable (JSON Lines) event stream
+ *   --report-files[=F]   end-of-run report of every path the tracees touched
+ *   --anti-anti-debug    spoof ptrace(PTRACE_TRACEME) results and hide
+ *                        TracerPid in reads of /proc/<pid>/status
+ *   --keep-alive[=N]     suppress exit_group up to N times per process
+ *   --packager           preset combining the above for AppImage work
+ *
+ * Copyright (c) 2026 The strace-appimage authors.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#ifndef STRACE_TRACING_EXT_H
+# define STRACE_TRACING_EXT_H
+
+# include "defs.h"
+
+/* Global extension state, set up during option parsing. */
+struct tracing_ext_state {
+	bool json;		/* --json */
+	bool report_files;	/* --report-files */
+	bool anti_debug;	/* --anti-anti-debug */
+	bool packager;		/* --packager (preset) */
+	int keep_alive;		/* --keep-alive=N (0 = off) */
+	bool keep_alive_set;	/* --keep-alive given explicitly */
+	bool report_files_set;	/* --report-files given explicitly */
+	FILE *report_fp;	/* report destination (NULL = shared log) */
+};
+
+extern struct tracing_ext_state ext;
+
+static inline bool
+extensions_active(void)
+{
+	return ext.json || ext.report_files || ext.anti_debug
+	       || ext.keep_alive > 0;
+}
+
+/* Per-syscall path capture (fed from printpathn and friends). */
+void ext_reset_paths(struct tcb *tcp);
+void ext_note_path(struct tcb *tcp, const char *path);
+/* Per-syscall human notes, emitted in JSON events and classic output. */
+void ext_reset_notes(struct tcb *tcp);
+void ext_add_note(struct tcb *tcp, const char *note);
+const char *ext_notes_joined(struct tcb *tcp, char sep);
+/* Per-tcb teardown; called from droptcb(). */
+void ext_free_tcb(struct tcb *tcp);
+/* Shared RFC 8259 string escaper (json events and file report). */
+void ext_json_print_string(FILE *fp, const char *s);
+
+/* json_out.c */
+void json_emit_begin(int argc, char **argv);
+void json_emit_syscall_event(struct tcb *tcp, const struct timespec *ts);
+void json_emit_signal_event(struct tcb *tcp, const char *signame,
+			    bool coredump);
+void json_emit_stop_event(struct tcb *tcp, const char *signame);
+void json_emit_exit_event(struct tcb *tcp, int code);
+void json_emit_summary(void);
+/* file_report.c */
+void file_report_note_syscall(struct tcb *tcp);
+void file_report_dump(FILE *out_fp);
+void file_report_free(void);
+/* anti_debug.c */
+void anti_debug_syscall_exiting(struct tcb *tcp);
+
+#endif /* !STRACE_TRACING_EXT_H */
