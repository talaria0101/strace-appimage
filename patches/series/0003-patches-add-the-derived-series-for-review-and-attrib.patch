++_try_cp() {
++	_src=$1
++	set -- "$(readlink -f "$1")" "$2"
++	if [ -e "$1" ] && [ ! -e "$2" ] && mkdir -p "${2%/*}"; then
++		cp -r "$1" "$2"
++		_echo "* added $_src"
++	fi
++}
