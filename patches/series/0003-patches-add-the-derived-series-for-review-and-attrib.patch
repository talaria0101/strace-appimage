++  "diff_hunk": "@@ -0,0 +1,167 @@\n+/*\n+ * Check LIRC_* ioctl decoding\n+ *\n+ * Copyright (C) 2022 Sean Young <sean@mess.org>\n+ */\n+\n+#include \"tests.h\"\n+#include <stdio.h>\n+#include <stdlib.h>\n+#include <sys/ioctl.h>\n+#include <linux/lirc.h>\n+\n+static const char *errstr;\n+\n+static long\n+do_ioctl(kernel_ulong_t cmd, int *arg)\n+{\n+\tlong rc = ioctl(-1, cmd, arg);\n+\n+\terrstr = sprintrc(rc);\n+\n+#ifdef INJECT_RETVAL\n+\tif (rc != INJECT_RETVAL)\n+\t\terror_msg_and_fail(\"Got a return value of %ld != %ld\",\n+\t\t\t\t   rc, (long) INJECT_RETVAL);\n+\n+\tstatic char inj_errstr[4096];\n+\n+\tsnprintf(inj_errstr, sizeof(inj_errstr), \"%s (INJECTED)\", errstr);\n+\terrstr = inj_errstr;\n+#endif\n+\n+\treturn rc;\n+}\n+\n+int\n+main(int argc, char *argv[])\n+{\n+\tint value;\n+#ifdef INJECT_RETVAL\n+\tunsigned long num_skip;\n+\tbool locked = false;\n+\n+\tif (argc < 2)\n+\t\terror_msg_and_fail(\"Usage: %s NUM_SKIP\", argv[0]);\n+\n+\tnum_skip = strtoul(argv[1], NULL, 0);\n+\n+\tfor (size_t i = 0; i < num_skip; i++) {\n+\t\tlong ret = ioctl(-1, LIRC_GET_FEATURES, 0);\n+\n+\t\tprintf(\"ioctl(-1, %s, NULL) = %s%s\\n\",\n+\t\t       XLAT_STR(LIRC_GET_FEATURES), sprintrc(ret),\n+\t\t       ret == INJECT_RETVAL ? \" (INJECTED)\" : \"\");\n+\n+\t\tif (ret != INJECT_RETVAL)\n+\t\t\tcontinue;\n+\n+\t\tlocked = true;\n+\t\tbreak;\n+\t}\n+\n+\tif (!locked)\n+\t\terror_msg_and_fail(\"Hasn't locked on ioctl(-1\"\n+\t\t\t\t   \", LIRC_GET_FEATURES, NULL) returning %d\",\n+\t\t\t\t   INJECT_RETVAL);\n+#endif\n+\n+\tvalue = 12000;\n+\tdo_ioctl(LIRC_SET_REC_TIMEOUT, &value);\n+\tprintf(\"ioctl(-1, %s, [12000]) = %s\\n\",\n+\t       XLAT_STR(LIRC_SET_REC_TIMEOUT), errstr);\n+\n+\tvalue = 1;\n+\tdo_ioctl(LIRC_SET_WIDEBAND_RECEIVER, &value);\n+\tprintf(\"ioctl(-1, %s, [1]) = %s\\n\",\n+\t       XLAT_STR(LIRC_SET_WIDEBAND_RECEIVER), errstr);\n+\n+\tvalue = 0;\n+\tdo_ioctl(LIRC_SET_MEASURE_CARRIER_MODE, &value);\n+\tprintf(\"ioctl(-1, %s, [0]) = %s\\n\",\n+\t       XLAT_STR(LIRC_SET_MEASURE_CARRIER_MODE), errstr);\n+\n+\tvalue = -1;\n+\tdo_ioctl(LIRC_SET_REC_TIMEOUT_REPORTS, &value);\n+\tprintf(\"ioctl(-1, %s, [-1]) = %s\\n\",\n+\t       XLAT_STR(LIRC_SET_REC_TIMEOUT_REPORTS), errstr);\n+\n+\tvalue = 33;\n+\tdo_ioctl(LIRC_SET_SEND_DUTY_CYCLE, &value);\n+\tprintf(\"ioctl(-1, %s, [33]) = %s\\n\",\n+\t       XLAT_STR(LIRC_SET_SEND_DUTY_CYCLE), errstr);\n+\n+\tvalue = 38000;\n+\tdo_ioctl(LIRC_SET_SEND_CARRIER, &value);\n+\tprintf(\"ioctl(-1, %s, [38000]) = %s\\n\",\n+\t       XLAT_STR(LIRC_SET_SEND_CARRIER), errstr);\n+\n+\tvalue = 20000;\n+\tdo_ioctl(LIRC_SET_REC_CARRIER, &value);\n+\tprintf(\"ioctl(-1, %s, [20000]) = %s\\n\",\n+\t       XLAT_STR(LIRC_SET_REC_CARRIER), errstr);\n+\n+\tvalue = 40000;\n+\tdo_ioctl(LIRC_SET_REC_CARRIER_RANGE, &value);\n+\tprintf(\"ioctl(-1, IPMICTL_SET_MAINTENANCE_MODE_CMD or %s, [40000]) = %s\\n\",\n+\t       XLAT_STR(LIRC_SET_REC_CARRIER_RANGE), errstr);\n+\n+\tvalue = 2;\n+\tdo_ioctl(LIRC_SET_SEND_MODE, &value);\n+\tprintf(\"ioctl(-1, %s, [LIRC_MODE_PULSE]) = %s\\n\",\n+\t       XLAT_STR(LIRC_SET_SEND_MODE), errstr);\n+\n+\tvalue = 8;\n+\tdo_ioctl(LIRC_SET_SEND_MODE, &value);\n+\tprintf(\"ioctl(-1, %s, [LIRC_MODE_SCANCODE]) = %s\\n\",\n+\t       XLAT_STR(LIRC_SET_SEND_MODE), errstr);\n+\n+\tvalue = 4;\n+\tdo_ioctl(LIRC_SET_REC_MODE, &value);\n+\tprintf(\"ioctl(-1, %s, [LIRC_MODE_MODE2]) = %s\\n\",\n+\t       XLAT_STR(LIRC_SET_REC_MODE), errstr);\n+\n+\tvalue = 16;\n+\tdo_ioctl(LIRC_SET_REC_MODE, &value);\n+\tprintf(\"ioctl(-1, %s, [LIRC_MODE_LIRCCODE]) = %s\\n\",\n+\t       XLAT_STR(LIRC_SET_REC_MODE), errstr);\n+\n+\t// read ioctl",
