++		# some very very old distros do not have /usr/bin/env, so for
++		# sh scripts it is better to always use #!/bin/sh instead
++		if grep -q '^#.*/usr/bin/env sh' "$s"; then
++			sed -i "1s|/usr/bin/env sh|/bin/sh|" "$s"
++		fi
