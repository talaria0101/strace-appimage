++	mkdir -p "$DST_BIN_DIR"
++	_echo "------------------------------------------------------------"
++	for bin do
++		b=${bin##*/}
++		_echo "Packing $bin as a static binary with onelf..."
++
++		_tmpdir=$TMPDIR/.onelf_build_$$_$b
++		rm -rf "$_tmpdir"
++		mkdir -p "$_tmpdir"
++
++		"$ONELF" bundle-libs "$_tmpdir" --from-binary "$bin" --strip --scan-dlopen
++		"$ONELF" pack "$_tmpdir" -o "$DST_BIN_DIR"/"$b" --command bin/"$b"
