.c stat.c stat64.c statfs.c statx.c strace.c string_to_uint.c swapon.c syscall.c sysctl.c sysinfo.c syslog.c sysmips.c term.c time.c times.c truncate.c ubi.c ucopy.c uid.c uid16.c umask.c umount.c uname.c userfaultfd.c ustat.c util.c utime.c utimes.c v4l2.c wait.c watchdog_ioctl.c xattr.c xlat.c xmalloc.c fetch_indirect_syscall_args.c fstatfs.c fstatfs64.c getpagesize.c ipc.c mmap_cache.c sigreturn.c socketcall.c statfs64.c sync_file_range.c sync_file_range2.c upeek.c upoke.c; do \\\r\n\tsed -n 's/^SYS_FUNC(.*/extern &;/p' $f; \\\r\ndone | sort -u > sys_func.h\r\ntcc -E -P -DHAVE_CONFIG_H    -I./linux/x86_64 -I./linux/x86_64 -I./linux -I./linux -I. -I.  -include config.h linux/x86_64/syscallent.h -o syscallent.i\r\ntcc: erro\r\nmake: *** [Makefile:9840: syscallent.i] Error 1\r\nrm ioctlsort0 ioctlsort1.o ioctlsort2 ioctlsort0.o ioctls_all0.h ioctlsort2.o ioctls_all2.h ioctls_all1.h ioctlsort1\r\n#\r\n```\r\n\r\nIt's not clear to me what specifiaclly is an 'unrecognized file type\"\r\n\r\nIs strace known to compile successfully with `tcc`?",
