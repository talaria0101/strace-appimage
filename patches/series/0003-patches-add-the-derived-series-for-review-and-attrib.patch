++	if [ -f "$hook" ]; then
++		return 0
++	fi
++
++	cat <<-'QS_HOOK' > "$hook"
++	#!/bin/sh
++	set -e
++	_deny_soundfonts_file=$CACHEDIR/.no-soundfont-${APPIMAGE##*/}
++	XDG_DATA_DIRS=$DATADIR:$APPDIR/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
