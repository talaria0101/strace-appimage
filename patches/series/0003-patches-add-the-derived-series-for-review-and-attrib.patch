++	        # found certificate at runtime...
++	        _host_cert=/tmp/.___host-certs/ca-certificates.crt
++	        if [ -d "$APPDIR"/lib/pkcs11 ] && [ ! -f "$_host_cert" ]; then
++	                mkdir -p /tmp/.___host-certs || :
++	                ln -sfn "$c" "$_host_cert" || :
++	        fi
++	fi
