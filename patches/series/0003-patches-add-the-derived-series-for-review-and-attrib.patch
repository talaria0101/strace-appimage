++  "body": "Most likely commit 238f5799fe1d87147e851f3fd099186185e39e3f brings some endianness issue, the net-icmp_filter.gen test started to fail on big endian platforms (s390x, ppc64)\r\n````\r\nFAIL: net-icmp_filter.gen\r\n=========================\r\n\r\n+ ../src/strace -V\r\n+ TIMEOUT='timeout -k 5 -s XCPU 1500'\r\n+ timeout -k 5 -s XCPU 1500 true\r\n+ '[' 1 -eq 0 ']'\r\n+ exec timeout -k 5 -s XCPU 1500 ./net-icmp_filter.gen.test\r\n+ run_strace_match_diff -e trace=getsockopt,setsockopt\r\n+ local sed_cmd prog_args\r\n+ prog_args=../net-icmp_filter\r\n+ sed_cmd=p\r\n+ args='-e trace=getsockopt,setsockopt'\r\n+ '[' -n '-e trace=getsockopt,setsockopt' -a '(' -z '' -o -z '-e trace=getsockopt,setsockopt' -o -z '-e trace=getsockopt,setsockopt' ')' ']'\r\n+ set -- -e trace=getsockopt,setsockopt END_OF_ARGUMENTS\r\n+ :\r\n+ arg=-e\r\n+ shift\r\n+ case \"$arg\" in\r\n+ set -- trace=getsockopt,setsockopt END_OF_ARGUMENTS -e\r\n+ :\r\n+ arg=trace=getsockopt,setsockopt\r\n+ shift\r\n+ case \"$arg\" in\r\n+ set -- END_OF_ARGUMENTS -e trace=getsockopt,setsockopt\r\n+ :\r\n+ arg=END_OF_ARGUMENTS\r\n+ shift\r\n+ case \"$arg\" in\r\n+ break\r\n+ run_prog\r\n+ '[' 0 -eq 0 ']'\r\n+ set -- ../net-icmp_filter\r\n+ args=../net-icmp_filter\r\n+ ../net-icmp_filter\r\n+ args=../net-icmp_filter\r\n+ run_strace -e trace=getsockopt,setsockopt ../net-icmp_filter\r\n+ args='-e trace=getsockopt,setsockopt ../net-icmp_filter'\r\n+ ../../src/strace -o log -e trace=getsockopt,setsockopt ../net-icmp_filter\r\n+ sed -n p\r\n+ match_diff out exp\r\n+ local output expected error\r\n+ '[' 2 -eq 0 ']'\r\n+ output=out\r\n+ shift\r\n+ '[' 1 -eq 0 ']'\r\n+ expected=exp\r\n+ shift\r\n+ '[' 0 -eq 0 ']'\r\n+ error='../../src/strace -e trace=getsockopt,setsockopt ../net-icmp_filter output mismatch'\r\n+ check_prog diff\r\n+ type diff\r\n+ diff -u -- exp out\r\n--- exp\t2022-11-27 18:03:29.147960201 +0000\r\n+++ out\t2022-11-27 18:03:29.147960201 +0000\r\n@@ -4,7 +4,7 @@\r\n setsockopt(-1, SOL_RAW, ICMP_FILTER, 0x3ffa31f4000, 4) = -1 EBADF (Bad file descriptor)\r\n setsockopt(-1, SOL_RAW, ICMP_FILTER, 0x3ffa31edffc, -2) = -1 EINVAL (Invalid argument)\r\n setsockopt(-1, SOL_RAW, ICMP_FILTER, ~[], 4) = -1 EBADF (Bad file descriptor)\r\n-setsockopt(-1, SOL_RAW, ICMP_FILTER, [], 4) = -1 EBADF (Bad file descriptor)\r\n-setsockopt(-1, SOL_RAW, ICMP_FILTER, [ICMP_ECHOREPLY ICMP_DEST_UNREACH ICMP_SOURCE_QUENCH ICMP_REDIRECT ICMP_TIME_EXCEEDED ICMP_PARAMETERPROB], 4) = -1 EBADF (Bad file descriptor)\r\n-setsockopt(-1, SOL_RAW, ICMP_FILTER, ~[ICMP_ECHOREPLY ICMP_DEST_UNREACH ICMP_SOURCE_QUENCH ICMP_REDIRECT ICMP_TIME_EXCEEDED ICMP_PARAMETERPROB], 8) = -1 EBADF (Bad file descriptor)\r\n+setsockopt(-1, SOL_RAW, ICMP_FILTER, [ICMP_DEST_UNREACH ICMP_ECHO 0x9 /* ICMP_??? */ ICMP_PARAMETERPROB ICMP_INFO_REQUEST ICMP_ADDRESS ICMP_ADDRESSREPLY 0x17 /* ICMP_??? */ 0x1a /* ICMP_??? */ 0x1e /* ICMP_??? */ 0x1f /* ICMP_??? */], 4) = -1 EBADF (Bad file descriptor)\r\n+setsockopt(-1, SOL_RAW, ICMP_FILTER, [ICMP_DEST_UNREACH ICMP_ECHO 0x9 /* ICMP_??? */ ICMP_PARAMETERPROB ICMP_INFO_REQUEST ICMP_ADDRESS ICMP_ADDRESSREPLY 0x17 /* ICMP_??? */ 0x1a /* ICMP_??? */ 0x1e /* ICMP_??? */ 0x1f /* ICMP_??? */], 4) = -1 EBADF (Bad file descriptor)\r\n+setsockopt(-1, SOL_RAW, ICMP_FILTER, ~[], 8) = -1 EBADF (Bad file descriptor)\r\n +++ exited with 0 +++\r\n+ fail_ '../../src/strace -e trace=getsockopt,setsockopt ../net-icmp_filter output mismatch'\r\n+ warn_ 'net-icmp_filter.gen.test: failed test: ../../src/strace -e trace=getsockopt,setsockopt ../net-icmp_filter output mismatch'\r\n+ printf '%s\\n' 'net-icmp_filter.gen.test: failed test: ../../src/strace -e trace=getsockopt,setsockopt ../net-icmp_filter output mismatch'\r\nnet-icmp_filter.gen.test: failed test: ../../src/strace -e trace=getsockopt,setsockopt ../net-icmp_filter output mismatch\r\n+ exit 1\r\nFAIL net-icmp_filter.gen.test (exit status: 1)\r\n````\r\n",
