++# github actions doesn't set USER and XDG_RUNTIME_DIR
++# causing some apps crash when running xvfb-run
++export USER="${LOGNAME:-${USER:-${USERNAME:-yomama}}}"
++export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
