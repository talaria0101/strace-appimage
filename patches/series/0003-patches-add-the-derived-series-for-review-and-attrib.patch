++++ b/tests-ext/run-unit-tests.sh
+@@ -0,0 +1,44 @@
++#!/bin/sh
++# run-unit-tests.sh -- compile and run the ptrace-free unit tests of the
++# strace-appimage extensions against a configured (built) strace tree.
++#
++# unit_json_escape includes src/tracing_ext.c as a single translation
++# unit (so the escaper is tested directly) and must not also link the
++# compiled object; unit_file_report includes src/file_report.c and links
++# the compiled tracing_ext object for ext_note_path()/ext_* helpers.
++#
++# Exit codes: 0 passed, 1 a test failed, 2 cannot run.
++# Part of the strace-appimage validation suite.
++
++set -u
++cd "$(dirname "$0")"
++
++SRC=../src
++[ -f "$SRC/config.h" ] || { echo "no $SRC/config.h: configure the strace tree first"; exit 2; }
++
++CC=${CC:-cc}
++CFLAGS="-DHAVE_CONFIG_H -I$SRC -I$SRC/linux/x86_64"
++OBJS="$SRC/libstrace_a-xmalloc.o $SRC/libstrace_a-error_prints.o"
++fail=0
++
++run() {
++	t=$1; objs=$2
++	printf '%s: ' "$t"
++	# shellcheck disable=SC2086
++	if $CC $CFLAGS -o "$t.bin" "$t.c" $objs 2> "$t.buildlog"; then
++		if "./$t.bin" > "$t.log" 2>&1; then
++			echo PASS
++		else
++			echo "FAIL (runtime, see $t.log)"
++			fail=1
++		fi
++	else
++		echo "FAIL (build, see $t.buildlog)"
++		fail=1
++	fi
++}
++
++run unit_json_escape "$OBJS"
++run unit_file_report "$OBJS $SRC/libstrace_a-tracing_ext.o"
++
++exit $fail
+diff --git a/tests-ext/testbin/antidebug_detect.c b/tests-ext/testbin/antidebug_detect.c
+new file mode 100644
+index 000000000..a0be7bdca
+--- /dev/null
++++ b/tests-ext/testbin/antidebug_detect.c
+@@ -0,0 +1,46 @@
++/* antidebug_detect.c -- minimal anti-debug target for A/B runs.
++ *
++ * Exits 42 when it detects a debugger (TRACEME fails or TracerPid != 0),
++ * exits 0 when it believes it is untraced.
++ *
++ *   vanilla strace  ./antidebug_detect   -> exits 42
++ *   ours --anti-anti-debug               -> exits 0
++ *
++ * Copyright (c) 2026 The strace-appimage authors.
++ * SPDX-License-Identifier: LGPL-2.1-or-later
++ */
++
++#include <fcntl.h>
++#include <stdio.h>
++#include <stdlib.h>
++#include <string.h>
++#include <sys/ptrace.h>
++#include <unistd.h>
++
++int
++main(void)
++{
++	if (ptrace(PTRACE_TRACEME, 0, 0, 0) < 0) {
++		puts("[detect] TRACEME failed: debugger!");
++		return 42;
++	}
++
++	char buf[8192];
++	int fd = open("/proc/self/status", O_RDONLY);
++	int n = read(fd, buf, sizeof(buf) - 1);
++
++	close(fd);
++	if (n <= 0)
++		return 42;
++	buf[n] = '\0';
++
++	char *p = strstr(buf, "TracerPid:");
++
++	if (!p || atoi(p + strlen("TracerPid:")) != 0) {
++		puts("[detect] TracerPid nonzero: debugger!");
++		return 42;
++	}
++
++	puts("[detect] clean");
++	return 0;
++}
+diff --git a/tests-ext/testbin/build.sh b/tests-ext/testbin/build.sh
+new file mode 100755
+index 000000000..8934d29c0
+--- /dev/null
++++ b/tests-ext/testbin/build.sh
+@@ -0,0 +1,48 @@
++#!/bin/sh
++# build.sh -- build the test targets for the validation suite.
++#
++# Prefers `zig cc` (easy static/cross builds) and falls back to the
++# system compiler.  Static glibc builds of dlopen-using programs need
++# libdl pieces that are not always available; a static build without
++# dlopen support is still produced to exercise static-binary tracing.
++#
++# Exit codes: 0 built, 1 a build failed, 2 cannot run.
++# Part of the strace-appimage validation suite.
++
++set -u
++cd "$(dirname "$0")"
++
++CC="${CC:-cc}"
++if command -v zig >/dev/null 2>&1; then
++	CC="zig cc"
++fi
++
++fail=0
++
++build() {
++	src=$1; bin=$2; shift 2
++	printf 'building %s ... ' "$bin"
++	if $CC -O2 -o "$bin" "$src" "$@" 2> "$bin.buildlog"; then
++		echo ok
++	else
++		echo "FAILED (see $bin.buildlog)"
++		fail=1
++	fi
++}
++
++build antidebug_detect.c antidebug_detect
++build hard_target.c hard_target -ldl
++
++# static variants: the interesting case LD_DEBUG=libs cannot cover at all
++if $CC -static -O2 -o hard_target_static hard_target.c -ldl \
++	2> hard_target_static.buildlog; then
++	echo "building hard_target_static ... ok"
++else
++	# static glibc without working dlopen: compile the target with
++	# dlopen disabled but keep the rest of the behaviour
++	$CC -static -O2 -DNOMKDIR_UNUSED -o hard_target_static \
++		hard_target.c 2>> hard_target_static.buildlog \
++	|| { echo "static build fallback also failed (see hard_target_static.buildlog)"; fail=1; }
++fi
++
++exit $fail
+diff --git a/tests-ext/testbin/hard_target.c b/tests-ext/testbin/hard_target.c
+new file mode 100644
+index 000000000..9192bbd14
+--- /dev/null
++++ b/tests-ext/testbin/hard_target.c
+@@ -0,0 +1,170 @@
++/*
++ * hard_target.c -- a deliberately hostile tracing target that exercises
++ * every strace-appimage extension in one run.
++ *
++ * Behaviour, in order:
++ *
++ *  1. anti-debug check #1: ptrace(PTRACE_TRACEME) self-test.
++ *     Under vanilla strace this returns EPERM (we are already traced)
++ *     and a real anti-debug target would quit here.
++ *  2. anti-debug check #2: read /proc/self/status with read(2) and
++ *     parse TracerPid.  Under vanilla strace TracerPid is the tracer's
++ *     pid (nonzero) and the target would quit here.
++ *  3. display probe: connect(2) to /tmp/.X11-unix/X0.  Headless hosts
++ *     fail with ENOENT, and GUI applications typically exit(3) right
++ *     after; this target calls exit_group(2) directly so that
++ *     --keep-alive can demonstrate what a suppressed exit reveals.
++ *  4. fallback path (only reachable if the exit was suppressed):
++ *     dlopen the software-rendering stack and open font/config paths
++ *     that a packager would need to bundle.
++ *  5. exec a child to exercise -f, and read /proc/self/status again
++ *     (pread this time) to exercise both rewrite paths.
++ *
++ * Build: cc -O2 -o hard_target hard_target.c -ldl
++ * Static: cc -static -O2 -o hard_target_static hard_target.c -ldl
++ *   (static glibc dlopen needs the static libdl; falls back to a no-op)
++ *
++ * Copyright (c) 2026 The strace-appimage authors.
++ * SPDX-License-Identifier: LGPL-2.1-or-later
++ */
++
++#include <dlfcn.h>
++#include <errno.h>
++#include <fcntl.h>
++#include <stdio.h>
++#include <stdlib.h>
++#include <string.h>
++#include <sys/ptrace.h>
++#include <sys/socket.h>
++#include <sys/syscall.h>
++#include <sys/un.h>
++#include <sys/wait.h>
++#include <unistd.h>
++
++static int detected;
++
++static void
++check_traceme(void)
++{
++	if (ptrace(PTRACE_TRACEME, 0, 0, 0) < 0) {
++		printf("[target] TRACEME self-check: EPERM -> debugger!"
++		       " (vanilla strace stops here; --anti-anti-debug"
++		       " spoofs success)\n");
++		detected = 1;
++	} else {
++		printf("[target] TRACEME self-check: clean\n");
++	}
++}
++
++static int
++read_tracerpid_pread(void)
++{
++	char buf[8192];
++	int fd = open("/proc/self/status", O_RDONLY);
++	int n;
++
++	if (fd < 0)
++		return -1;
++	n = pread(fd, buf, sizeof(buf) - 1, 0);
++	close(fd);
++	if (n <= 0)
++		return -1;
++	buf[n] = '\0';
++	{
++		char *p = strstr(buf, "TracerPid:");
++
++		if (!p)
++			return -1;
++		return atoi(p + strlen("TracerPid:"));
++	}
++}
++
++static void
++check_tracerpid(void)
++{
++	int tp = read_tracerpid_pread();
++
++	if (tp < 0) {
++		printf("[target] TracerPid check: unreadable\n");
++	} else if (tp != 0) {
++		printf("[target] TracerPid check: %d -> debugger!"
++		       " (vanilla strace shows the real tracer;"
++		       " --anti-anti-debug rewrites it to 0)\n", tp);
++		detected = 1;
++	} else {
++		printf("[target] TracerPid check: clean (0)\n");
++	}
++}
++
++static int
++have_display(void)
++{
++	struct sockaddr_un sa = { .sun_family = AF_UNIX };
++	int fd = socket(AF_UNIX, SOCK_STREAM, 0);
++
++	if (fd < 0)
++		return 0;
++	strcpy(sa.sun_path, "/tmp/.X11-unix/X0");
++	if (connect(fd, (struct sockaddr *) &sa, sizeof(sa)) == 0) {
++		close(fd);
++		return 1;
++	}
++	close(fd);
++	return 0;
++}
++
++static void
++fallback_path(void)
++{
++	/* What a packager needs to see from the fallback branch. */
++	void *h = dlopen("libGL.so.1", RTLD_LAZY | RTLD_LOCAL);
++
++	printf("[target] fallback: dlopen libGL.so.1 -> %s\n",
++	       h ? "loaded" : dlerror() ?: "failed");
++	if (h)
++		dlclose(h);
++
++	h = dlopen("libX11.so.6", RTLD_LAZY | RTLD_LOCAL);
++	printf("[target] fallback: dlopen libX11.so.6 -> %s\n",
++	       h ? "loaded" : dlerror() ?: "failed");
++	if (h)
++		dlclose(h);
++
++	int fd = open("/usr/share/fonts/truetype/dejavu/"
++		      "DejaVuSans.ttf", O_RDONLY);
++	printf("[target] fallback: open DejaVuSans.ttf -> %s\n",
++	       fd >= 0 ? "ok" : strerror(errno));
++	if (fd >= 0)
++		close(fd);
++}
++
++int
++main(void)
++{
++	check_traceme();
++	check_tracerpid();
++
++	if (!have_display()) {
++		printf("[target] no display; real apps exit() here;"
++		       " exit_group(1) now (--keep-alive suppresses it)\n");
++		fflush(stdout);
++		syscall(SYS_exit_group, 1);
++		/*
++		 * Reached only when the tracer suppressed the exit.
++		 */
++		fallback_path();
++	}
++
++	{
++		pid_t pid = fork();
++
++		if (pid == 0)
++			_exit(execl("/bin/true", "true", (char *) 0));
++		if (pid > 0)
++			waitpid(pid, NULL, 0);
++	}
++
++	check_tracerpid();
++	printf("[target] done%s\n", detected ? " (anti-debug FIRED)" : "");
++	return detected ? 42 : 0;
++}
