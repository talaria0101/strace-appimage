++# skip non executable binaries and .node binaries
++# these are actually libraries and cannot be wrapped with sharun
++_is_deployable_binary() {
++	if [ -x "$1" ]; then
++		case "$1" in
++			*.node) :;;
++			*) return 0;;
++		esac
++	fi
++	return 1
