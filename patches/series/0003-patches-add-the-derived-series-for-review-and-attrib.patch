++		_patch_away_usr_share_dir "$lib" || :
++		;;
++	*/p11-kit-trust.so*)
++		# Because OpenSUSE had to ruin this, we will have to patch the
++		# the certificates to a path in /tmp that we will later make
++		# a symlink that points to the real host certs location
