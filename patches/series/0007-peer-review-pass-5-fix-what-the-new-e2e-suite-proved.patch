diff --git a/tests-ext/testbin/inherit_target.c b/tests-ext/testbin/inherit_target.c
new file mode 100644
index 000000000..e8fc4aa95
--- /dev/null
+++ b/tests-ext/testbin/inherit_target.c
@@ -0,0 +1,46 @@
+/*
+ * inherit_target.c -- exercises exec-time fd inheritance: the parent
+ * opens handed.txt (no CLOEXEC), forks; the child inherits the fd and
+ * execs /bin/true.  A --report-files run must record handed.txt in the
+ * report with an `inherit` operation on the exec, even though no
+ * traced process ever *opened* it at exec time.
+ *
+ * Build: cc -O2 -o inherit_target inherit_target.c
+ *
+ * Copyright (c) 2026 The strace-appimage authors.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+int
+main(void)
+{
+	int fd = open("handed.txt", O_CREAT | O_WRONLY | O_TRUNC, 0644);
+
+	if (fd < 0) {
+		perror("open handed.txt");
+		return 1;
+	}
+	write(fd, "handoff\n", 8);
+
+	pid_t pid = fork();
+
+	if (pid < 0) {
+		perror("fork");
+		return 1;
+	}
+	if (pid == 0) {
+		/* the fd crosses fork AND exec */
+		execl("/bin/true", "true", (char *) 0);
+		_exit(127);
+	}
+	waitpid(pid, NULL, 0);
+	close(fd);
+	printf("[inherit] done\n");
+	return 0;
+}
diff --git a/tests-ext/testbin/oneshot_exit.c b/tests-ext/testbin/oneshot_exit.c
new file mode 100644
index 000000000..310d7535d
--- /dev/null
+++ b/tests-ext/testbin/oneshot_exit.c
@@ -0,0 +1,30 @@
+/*
+ * oneshot_exit.c -- a target whose every exit attempt is the same:
+ * exit_group(7) -- once directly, once by returning from main.  Under
+ * --keep-alive both are suppressed and the process falls off its exit
+ * path (glibc ends _exit in hlt) and faults; the tracer must then
+ * report the suppressed exit_group's status (7), not the fault signal,
+ * so the run stays exit-status-clean.
+ *
+ * Build: cc -O2 -o oneshot_exit oneshot_exit.c
+ *
+ * Copyright (c) 2026 The strace-appimage authors.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include <stdio.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+int
+main(void)
+{
+	printf("[oneshot] first exit_group(7)\n");
+	fflush(stdout);
+	syscall(SYS_exit_group, 7);
+
+	/* reachable only under --keep-alive */
+	printf("[oneshot] still alive after suppressed exit\n");
+	fflush(stdout);
+	return 7;			/* glibc: exit_group(7) again */
+}
diff --git a/tests-ext/testbin/relpath_target.c b/tests-ext/testbin/relpath_target.c
new file mode 100644
index 000000000..76dada3b7
--- /dev/null
+++ b/tests-ext/testbin/relpath_target.c
@@ -0,0 +1,67 @@
+/*
+ * relpath_target.c -- exercises relative-path capture: the report must
+ * contain resolved absolute paths for
+ *   1. a plain relative open after chdir (cwd resolution),
+ *   2. an openat through a dirfd (fd resolution),
+ *   3. an openat with AT_FDCWD and a relative path.
+ * Exits 0 on success (the opens worked), nonzero otherwise.
+ *
+ * Build: cc -O2 -o relpath_target relpath_target.c
+ *
+ * Copyright (c) 2026 The strace-appimage authors.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+int
+main(void)
+{
+	char cwd[4096];
+
+	if (!getcwd(cwd, sizeof(cwd))) {
+		perror("getcwd");
+		return 1;
+	}
+
+	/* 1. relative open, cwd-relative */
+	int fd = open("data.txt", O_CREAT | O_WRONLY | O_TRUNC, 0644);
+
+	if (fd < 0) {
+		perror("open data.txt");
+		return 1;
+	}
+	close(fd);
+
+	/* 2. openat through a real dirfd (the directory itself) */
+	int dfd = open(".", O_RDONLY | O_DIRECTORY);
+
+	if (dfd < 0) {
+		perror("open .");
+		return 1;
+	}
+	fd = openat(dfd, "data2.txt", O_CREAT | O_WRONLY | O_TRUNC, 0644);
+
+	if (fd < 0) {
+		perror("openat data2.txt");
+		return 1;
+	}
+	close(fd);
+
+	/* 3. openat with AT_FDCWD, relative path */
+	fd = openat(AT_FDCWD, "data3.txt", O_CREAT | O_WRONLY | O_TRUNC,
+		    0644);
+
+	if (fd < 0) {
+		perror("openat AT_FDCWD data3.txt");
+		return 1;
+	}
+	close(fd);
+	close(dfd);
+
+	printf("[relpath] done in %s\n", cwd);
+	return 0;
+}
