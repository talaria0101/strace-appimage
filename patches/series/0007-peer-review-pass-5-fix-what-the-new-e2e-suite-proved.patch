+	if (snprintf(full, sizeof(full), "%s/%s", dirbuf, path)
+	    >= (int) sizeof(full)) {
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	return faccessat(AT_FDCWD, full, mode, flags);
+}
