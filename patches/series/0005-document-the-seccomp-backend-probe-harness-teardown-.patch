+		if (w == pid) {
+			CHECK(WIFEXITED(st) && WEXITSTATUS(st) == 0,
+			      "tracee completed with forged/emulated syscalls");
+			break;
+		}
+		if (w < 0)
+			break;
+		usleep(20000);
 	}
 	CHECK(saw_write, "P3 saw write() notification, forged retval honored");
 	CHECK(saw_open, "P5 openat emulated via ADDFD");
